{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "mockups",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const d=p.resolve('design-mockups'),pub=p.resolve('public');h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);let base=u.startsWith('/public/')?pub:d;let rel=u.startsWith('/public/')?u.slice(8):u.slice(1);let fp=p.join(base,rel||'');if(!fp.startsWith(base)){r.writeHead(403);return r.end()}f.readFile(fp,(e,b)=>{if(e){r.writeHead(404);r.end('not found');return}const t={'.html':'text/html; charset=utf-8','.png':'image/png','.svg':'image/svg+xml','.jpg':'image/jpeg'}[p.extname(fp)]||'application/octet-stream';r.writeHead(200,{'Content-Type':t});r.end(b)})}).listen(4100,'127.0.0.1')"
      ],
      "port": 4100
    }
  ]
}
